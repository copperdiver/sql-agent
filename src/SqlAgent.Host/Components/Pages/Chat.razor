@page "/"
@page "/chat/{Id:guid}"
@implements IDisposable
@inject ScopedRunner Runner
@inject AppState State
@inject NavigationManager Nav

<div class="chat">
    @if (_messages.Count == 0)
    {
        <div class="chat-hero">
            <h1>How can I help with your data?</h1>
            <p class="muted">Attach a database, then ask in plain language.</p>
        </div>
    }
    else
    {
        <MessageList Messages="_messages" Live="_live" OnOpenInEditor="OpenInEditor" />
    }

    <div class="chat-composer">
        <Composer @ref="_composer"
                  Value="@_question" ValueChanged="v => _question = v"
                  Attached="_attached" OnRemoveAttachment="Detach"
                  Busy="_busy" OnSend="SendAsync" OnStop="Stop">
            <Tools>
                <AttachmentMenu Connections="_connections"
                                AttachedIds="@(_attached.Select(a => a.ConnectionId!.Value).ToList())"
                                OnAttach="Attach" />
            </Tools>
        </Composer>

        @if (_messages.Count == 0)
        {
            <div class="suggestions">
                @foreach (var suggestion in Suggestions)
                {
                    @* Prefill and focus, never send. One click on a chip with no model configured would
                       otherwise answer with an error panel before the question could be edited. *@
                    <button type="button" class="ghost suggestion" data-testid="suggestion"
                            @onclick="() => PrefillAsync(suggestion)">@suggestion</button>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly string[] Suggestions =
    [
        "Explain this schema",
        "Show table relationships",
        "Find the largest tables",
    ];

    private readonly List<ChatMessageView> _messages = [];
    private readonly Dictionary<Guid, NlQueryResult> _live = [];
    private readonly List<ChatDatabaseRef> _attached = [];
    private IReadOnlyList<DatabaseConnectionInfo> _connections = [];
    private Composer? _composer;
    private string _question = "";
    private bool _busy;
    private CancellationTokenSource? _cts;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        // Connections change from the Connections page, which is a sibling route in the same circuit —
        // the same reason SchemaRail subscribes to this event rather than reading its list once.
        State.ConnectionsChanged += OnConnectionsChanged;
        await ReloadConnectionsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // The send below navigates to /chat/{id} after creating the chat, which re-enters this method
        // with the id of the conversation already in memory. Reloading it from the store there would
        // throw away _live and redraw the answer the user is looking at as a restored one, rows gone.
        //
        // _loadedChatId starts life as the sentinel below rather than null, specifically so this method
        // still runs its body on the very first render of "/" (where Id is also null). Guarding on
        // `Id == _loadedChatId` with both sides starting null would short-circuit that first call before
        // State.SetActiveChat ever ran, leaving AppState pointing at whatever chat was active before —
        // wrong, and with no consumer yet to make the symptom visible.
        if (Id == _loadedChatId) return;
        _loadedChatId = Id;
        _messages.Clear();
        _live.Clear();
        // Attachments are per-conversation, not per-circuit: carrying prod's chips into a brand-new chat
        // (or someone else's, reached via history) would send them somewhere the user never attached them.
        _attached.Clear();
        if (Id is { } id)
        {
            var detail = await Runner.RunAsync<ChatService, ChatDetail?>(s => s.GetChatAsync(id));
            if (detail is null)
            {
                // A bookmarked link to a chat that was since deleted, or another tab deleted it while
                // this one sat on the route. _loadedChatId is reset to null here — not left at the
                // missing id — because SendAsync reads _loadedChatId directly as the id to continue;
                // leaving it pointed at a chat that does not exist would have the very next send reach
                // ChatService.AppendOnceAsync's `?? throw new InvalidOperationException("Chat ...
                // does not exist.")`, uncaught (SendAsync's catch is OperationCanceledException only,
                // and ScopedRunner does not catch either), losing the typed question to an error panel.
                // Navigating home is the visible half of the fix, syncing the address bar to what the
                // page now shows; the reset above is what actually keeps the next send safe, in case the
                // router does not re-enter this method before the user acts.
                _loadedChatId = null;
                State.SetActiveChat(null);
                Nav.NavigateTo("/", replace: true);
                return;
            }
            _messages.AddRange(detail.Messages);
        }
        State.SetActiveChat(Id);
    }

    /// <summary>Sentinel distinct from any real chat id AND from null, so the guard above still runs on
    /// the first render of "/" (Id null) instead of matching this field's own uninitialized default.</summary>
    private static readonly Guid Unloaded = Guid.NewGuid();
    private Guid? _loadedChatId = Unloaded;

    private async Task ReloadConnectionsAsync()
    {
        _connections = await Runner.RunAsync<DatabaseConnectionService, IReadOnlyList<DatabaseConnectionInfo>>(
            s => s.ListAsync());
        // A connection deleted elsewhere must not stay in the chips: sending it would resolve to
        // "(deleted database)" and the user would have had no warning it was gone.
        _attached.RemoveAll(a => !_connections.Any(c => c.Id == a.ConnectionId));
    }

    private void OnConnectionsChanged() => InvokeAsync(async () =>
    {
        await ReloadConnectionsAsync();
        StateHasChanged();
    });

    private void Attach(DatabaseConnectionInfo connection)
    {
        if (_attached.Any(a => a.ConnectionId == connection.Id)) return;
        _attached.Add(new ChatDatabaseRef(connection.Id, connection.Name));
    }

    private void Detach(ChatDatabaseRef database) =>
        _attached.RemoveAll(a => a.ConnectionId == database.ConnectionId);

    private async Task PrefillAsync(string suggestion)
    {
        _question = suggestion;
        if (_composer is not null) await _composer.FocusAsync();
    }

    private async Task SendAsync()
    {
        // Mirrors the SQL page's guard, and for the same reason: Enter is a second entry point that does
        // not go through the button's disabled attribute.
        if (_busy || string.IsNullOrWhiteSpace(_question)) return;
        _busy = true;
        var question = _question;
        _question = "";
        var databaseIds = _attached.Select(a => a.ConnectionId!.Value).ToList();
        // Captured up front: this component instance is reused across "/" and "/chat/{Id}" (that reuse is
        // why OnParametersSetAsync's guard exists), so _loadedChatId can change under us while the send
        // below is in flight — the user opens a stored chat, or leaves for /sql entirely. Comparing the
        // live field against this snapshot after the await, rather than trusting the field directly, is
        // what tells the difference between "this send created/continued startedIn" (normal) and "the
        // page moved on to something else while it was still running" (must be dropped).
        var startedIn = _loadedChatId;
        _cts = new CancellationTokenSource();
        try
        {
            var turn = await Runner.RunAsync<ChatTurnService, ChatTurnResult>(
                s => s.SendAsync(startedIn, question, databaseIds, _cts.Token));

            // Raised before the drop check below, and unconditionally: the chat this turn created or
            // continued is on disk either way (ChatTurnService's job, not this method's), even when the
            // send is about to be dropped for landing after the page moved on. Unlike SetActiveChat and
            // NavigateTo just below — which assume the page is still showing the chat this turn belongs
            // to — telling the sidebar to reload assumes nothing about what is on screen now, so it is
            // safe here too. Doing it after the drop check would leave a chat the user can no longer see
            // missing from the sidebar until something unrelated happened to refresh it.
            State.NotifyChatsChanged();

            if (_disposed || _loadedChatId != startedIn)
            {
                // The page moved on while this was in flight: to another stored chat, to a fresh "/", or
                // off the route entirely (Dispose below cancels _cts, but ChatTurnService can still return
                // an ordinary — if apologetic — result rather than throw, so this continuation still runs
                // against a torn-down or repurposed instance). The turn landed on disk under its own
                // ChatId regardless; that is ChatTurnService's job, not this method's. Appending it here
                // would mix one conversation's messages into whatever is on screen now, and navigating
                // would drag the user back into a chat — or off a route — they already left. Reopening the
                // chat this send belonged to shows the answer, because it is on disk either way.
                return;
            }

            _messages.Add(turn.UserMessage);
            _messages.Add(turn.AssistantMessage);
            if (turn.Live is { } live) _live[turn.AssistantMessage.Id] = live;

            // The chips deliberately stay: attachments are per message, but re-attaching every turn
            // would make a ten-question conversation ten attachments.
            if (_loadedChatId != turn.ChatId)
            {
                _loadedChatId = turn.ChatId;
                // replace, so Back does not walk into the same conversation's empty state.
                Nav.NavigateTo($"/chat/{turn.ChatId}", replace: true);
                State.SetActiveChat(turn.ChatId);
            }
        }
        catch (OperationCanceledException)
        {
            // ChatTurnService now converts a cancellation during the model call or the query execution
            // into an ordinary ChatTurnResult carrying execution_canceled, specifically so a stop click
            // never orphans the chat row it already wrote — see ChatTurnService.AnswerAsync. What can
            // still throw here is a cancellation that lands even earlier, before that row exists at all:
            // while attachments are still being resolved, or while the chat/question themselves are being
            // written. Nothing is on disk yet in that case, so the typed text is the only copy anywhere —
            // dropping it too would be exactly the outcome ChatTurnService's own doc comment says this
            // design refuses. Restored only if the page is still where this send started: if it moved on
            // (disposed, or re-parameterized into a different chat) there is no composer left to put it
            // back into, and doing it anyway would inject this text into whatever the user is looking at
            // now.
            if (!_disposed && _loadedChatId == startedIn) _question = question;
        }
        finally
        {
            _busy = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private void Stop() => _cts?.Cancel();

    private void OpenInEditor(string sql)
    {
        // The editor is a separate route now, so the SQL travels through AppState rather than a tab flip.
        State.HandOffSql(sql);
        Nav.NavigateTo("/sql");
    }

    public void Dispose()
    {
        _disposed = true;
        // Leaving the page entirely (a route with a different component, e.g. /sql) does not change
        // _loadedChatId — there is no re-parameterization to detect that here, unlike navigating between
        // "/" and "/chat/{Id}". Cancelling lets ChatTurnService's own cancellation handling shorten the
        // in-flight call instead of it running to completion in the background against a disposed page.
        _cts?.Cancel();
        State.ConnectionsChanged -= OnConnectionsChanged;
    }
}
