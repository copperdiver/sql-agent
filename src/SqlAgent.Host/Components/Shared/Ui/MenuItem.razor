<div class="menu-item @(Danger ? "danger" : "")">
    @* No role="menuitem": Menu's panel is not a role="menu" (see the comment there), and a menuitem
       outside a menu is a role with no container to belong to. A plain <button> already announces as
       a button and is reachable by Tab, which is what this row actually offers. *@
    <button type="button" class="menu-item-action" @onclick="Activate">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <Icon Name="@Icon" Size="16" />
        }
        <span class="menu-item-label">@ChildContent</span>
    </button>
    @if (Trailing is not null)
    {
        @* No stopPropagation needed: Trailing is a sibling of the action button, not a descendant, so
           a click inside it can never reach the button's Activate handler in the first place — sibling
           structure keeps the two independent, exactly as Menu and Modal document their own
           backdrop/panel pairs. *@
        <span class="menu-item-trailing">@Trailing</span>
    }
</div>

@code {
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Trailing { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Danger { get; set; }

    /// <summary>Whether activating this row dismisses the menu. Defaults to true (choosing an action
    /// should close the menu that offered it). Set false for a row whose action button has no real
    /// effect of its own -- e.g. a label wrapping a Trailing widget that does the actual work -- so that
    /// clicking the label doesn't just close the menu with no feedback.</summary>
    [Parameter] public bool CloseOnClick { get; set; } = true;

    /// <summary>The menu this item lives in, so choosing an item dismisses it. Cascaded by Menu.</summary>
    [CascadingParameter] private Menu? Owner { get; set; }

    private async Task Activate()
    {
        // Close first: if OnClick navigates, the menu would otherwise be left open behind the new page,
        // and a caller that throws would strand it open with no backdrop click able to reach it.
        if (CloseOnClick) Owner?.Close();
        await OnClick.InvokeAsync();
    }
}
