@implements IDisposable
@inject ShortcutService Shortcuts

@* tabindex is what makes @onkeydown fire on a div at all, and -1 keeps the wrapper out of the tab
   order so Escape works without adding a phantom tab stop before every menu. *@
<div class="menu-root" @onkeydown="OnKeyDown" tabindex="-1">
    @* A real <button>, not a div: clicking it moves focus onto it, and since it lives inside
       .menu-root, a real user's Escape keypress bubbles to OnKeyDown below. A div never receives
       focus on click, so Escape would have nothing to bubble from. *@
    <button type="button" class="menu-trigger" @onclick="Toggle"
            aria-haspopup="true" aria-expanded="@(_open ? "true" : "false")">@Trigger</button>

    @if (_open)
    {
        @* A plain element, not a document-level JS listener: this works in the static first render
           and needs no interop, and clicks on the menu's own panel never reach it because the panel
           is a sibling painted above it. *@
        <div class="menu-backdrop" @onclick="Close"></div>
        @* Deliberately NOT role="menu". ARIA lets a menu own only menuitem/menuitemradio/
           menuitemcheckbox/group/separator, and a group inside a menu must itself contain menu items.
           This panel holds neither shape: MenuItem renders a plain wrapper div whose activating button
           is a grandchild, and UserCard puts a ThemeToggle (a role="group" of three plain buttons) in a
           row's Trailing slot. Claiming "menu" there makes NVDA/JAWS switch into menu mode and expose
           only the owned menu items, which silently drops the theme buttons out of arrow-key navigation
           — the control becomes unreachable from the very popover that contains it. Plain buttons in a
           popover is what this actually is, and announcing it honestly keeps every child reachable;
           the trigger's aria-haspopup/aria-expanded above still convey that a popover is involved. *@
        <div class="menu-panel @PlacementClass">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </div>
    }
</div>

@code {
    [Parameter] public RenderFragment? Trigger { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public MenuPlacement Placement { get; set; } = MenuPlacement.Bottom;

    private bool _open;

    private string PlacementClass => Placement switch
    {
        MenuPlacement.Top => "place-top",
        MenuPlacement.Right => "place-right",
        _ => "place-bottom",
    };

    private void Toggle()
    {
        _open = !_open;
        // Subscribed only while open: a sidebar of twenty rows would otherwise hold twenty live handlers
        // for the life of the circuit and run all of them on every Escape. Same discipline as the
        // drawer's conditional keydown handler.
        if (_open) Shortcuts.EscapePressed += OnGlobalEscape;
        else Shortcuts.EscapePressed -= OnGlobalEscape;
    }

    public void Close()
    {
        // StateHasChanged is required here, unlike in Toggle/OnKeyDown: those run as Menu's own event
        // handlers, which Blazor re-renders automatically once the handler returns. MenuItem calls this
        // method on a sibling component instance (via the cascaded Owner), and mutating a field on a
        // component that isn't itself handling the event does not queue that component for re-render.
        if (_open) Shortcuts.EscapePressed -= OnGlobalEscape;
        _open = false;
        StateHasChanged();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    /// <summary>The document-level Escape. The local handler above still exists and still works
    /// everywhere it fires; this is what covers Safari, where a click leaves no focused element for the
    /// keypress to bubble from.</summary>
    private void OnGlobalEscape() => InvokeAsync(Close);

    public void Dispose() => Shortcuts.EscapePressed -= OnGlobalEscape;
}
