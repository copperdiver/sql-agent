@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject ILogger<ThemeToggle> Logger

<Segmented Options="Options" Value="@_theme" ValueChanged="ApplyAsync"
           AriaLabel="Theme" ShowLabels="ShowLabels" />

@code {
    [Parameter] public bool ShowLabels { get; set; }

    private static readonly IReadOnlyList<SegmentedOption> Options =
    [
        new("system", "System", "monitor"),
        new("light", "Light", "sun"),
        new("dark", "Dark", "moon"),
    ];

    private string _theme = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Read, do not assume: theme.js already applied the stored value to <html> before this circuit
        // existed, so the server's only way to show the right selection is to ask the browser.
        if (!firstRender) return;
        try
        {
            _theme = Normalize(await JS.InvokeAsync<string>("sqlAgentUi.getTheme"));
        }
        catch (Exception ex)
        {
            // Private-mode localStorage throws rather than returning null, a disconnected circuit
            // throws JSDisconnectedException, and a missing/renamed sqlAgentUi.getTheme (theme.js
            // failed to load, or drifted from this component) throws JSException. None of those are
            // worth failing the page over: "system" is the same default theme.js itself falls back to,
            // so the control stays truthful. Logged at Debug rather than swallowed outright: private-mode
            // storage is routine, but a renamed/missing interop call is a real bug that would otherwise
            // leave the control silently and permanently wrong with zero evidence in any log.
            Logger.LogDebug(ex, "sqlAgentUi.getTheme failed; ThemeToggle is falling back to system.");
            _theme = "system";
        }
        StateHasChanged();
    }

    private async Task ApplyAsync(string theme)
    {
        _theme = theme;
        try
        {
            await JS.InvokeVoidAsync("sqlAgentUi.setTheme", theme);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // JSException and JSDisconnectedException are siblings under System.Exception, not a
            // base/derived pair, so a filter has to name both explicitly rather than catching only one
            // and assuming it covers the other. Both mean the same thing here — the browser is not
            // reachable to theme, whether because the circuit is gone (disconnected: a dropped
            // WebSocket, a closed tab) or because sqlAgentUi.setTheme itself is missing/broken (a
            // JSException — theme.js failed to load or drifted from this component). The latter is
            // exactly what the read path above already tolerates: OnAfterRenderAsync's catch renders a
            // normal-looking toggle in that case, so a click here must not then take an unhandled
            // exception through this event handler and kill the circuit — Task 5 mounts this in the
            // sidebar, outside WorkArea's ErrorBoundary, so nothing else would catch it. _theme is left
            // at the clicked value rather than reverted: applyTheme() never ran either way, so the
            // visual state is already wrong, and reverting the selection would just make the control
            // fight the user's own click. A genuine programming error in this method (any other
            // exception type) still surfaces, since the filter names only these two.
            Logger.LogDebug(ex, "sqlAgentUi.setTheme failed for theme {Theme}.", theme);
        }
    }

    /// <summary>
    /// sqlAgentUi.getTheme() returns the raw localStorage string with no validation of its own
    /// (theme.js just echoes back whatever was stored). A hand-edited devtools entry, or a value
    /// written by a future version this build doesn't know about, must not become the Value handed to
    /// Segmented: Segmented selects by exact match, so an unrecognized string would highlight none of
    /// the three buttons and leave the control looking broken with no indication why. Falling back to
    /// "system" mirrors the default theme.js itself uses, so this stays truthful either way.
    /// </summary>
    private static string Normalize(string? theme) => theme switch
    {
        "light" or "dark" => theme,
        _ => "system",
    };
}
