@implements IDisposable
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject ShortcutService Shortcuts
@inject ILogger<Modal> Logger

<div class="modal-root" @onkeydown="OnKeyDown" tabindex="-1">
    <div class="modal-scrim" @onclick="Close"></div>
    @* No stopPropagation needed: the scrim and the panel are siblings under .modal-root, not nested,
       and the panel paints above the scrim (z-index: 1). A click inside the panel hit-tests to the
       panel itself and can never reach the scrim's handler, exactly as Menu's backdrop/panel pair
       works. *@
    <div class="modal-panel" role="dialog" aria-modal="true" aria-label="@Title">
        <div class="modal-head">
            <h3>@Title</h3>
            <button type="button" class="ghost modal-close" @onclick="Close" aria-label="Close" @ref="_closeButton">
                <Icon Name="x" Size="18" />
            </button>
        </div>
        <div class="modal-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="modal-foot">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>What to focus once the dialog has actually rendered. A <c>Func</c> rather than an
    /// <see cref="ElementReference"/> directly: a caller's own field (e.g. NameDialog's input) is still
    /// <c>default</c> at the point this parameter is bound -- its element does not exist in the DOM yet
    /// -- and only resolves to something real by the time <see cref="OnAfterRenderAsync"/> below actually
    /// invokes the callback. Defaults to this dialog's own close button, so every caller gets a real
    /// focus move even when it supplies nothing more specific -- MoveToProjectDialog and the About dialog,
    /// for instance, have no single field that deserves it more than another.
    ///
    /// This is the only FocusAsync call a dialog should make. NameDialog and SearchDialog both pass their
    /// own field through this parameter rather than also calling FocusAsync themselves in their own
    /// OnAfterRenderAsync -- SearchDialog used to do exactly that, on the assumption that its own call,
    /// running after this component's default per the child-before-parent OnAfterRenderAsync ordering,
    /// would simply overwrite it. Checked in a real browser rather than trusted, that assumption was
    /// backwards: this component's own focus move landed second and silently won, leaving the search
    /// input unfocused while typing did nothing. Routing every caller's target through this one parameter
    /// removes the ordering question entirely -- there is exactly one FocusAsync call per dialog, made
    /// here, and nothing left to race.
    ///
    /// autofocus cannot do this job, on the close button or anywhere else: per the HTML spec a browser
    /// only honors autofocus while the document's focused area is still &lt;body&gt; at insertion time,
    /// and every dialog here is opened by a click or a keydown, both of which move focus away from body
    /// before the dialog exists. Verified in Chromium rather than assumed -- see Sidebar.razor's
    /// FocusDrawerIfJustOpenedAsync for the standalone probe. FocusAsync, called explicitly here, has no
    /// such restriction.
    ///
    /// This is what lets a real Escape keypress reach OnKeyDown below via bubbling, but it is not what
    /// makes Escape close a dialog in every browser: that is Shortcuts.EscapePressed, subscribed below,
    /// which fires regardless of where focus is and is the only path that reaches a dialog whose focus
    /// move above failed or raced the interop call. Do not delete that subscription on the strength of
    /// this one -- Safari in particular does not focus a button on a plain mouse click at all (see
    /// ShortcutService's own doc comment), so a dialog opened by mouse there has nothing for a bubbling
    /// Escape to start from regardless of what this parameter focuses.</summary>
    [Parameter] public Func<ElementReference>? InitialFocus { get; set; }

    /// <summary>Changes value when the caller wants focus moved to <see cref="InitialFocus"/> again, on a
    /// render that is not the first. A dialog re-shown with a validation error is the case:
    /// DialogService swaps the render fragment, Blazor sees the same component type at the same position
    /// and reuses the instance, so firstRender is false and the focus move above never runs -- leaving the
    /// user to click back into the field to correct the name they just typed.
    ///
    /// An opaque object rather than a bool or a counter type: the two failed prior fixes for this class of
    /// bug (see this parameter's own history above) each reached for the type that was convenient at the
    /// call site rather than the type the job needed, and a bool can only ask "is a request pending", which
    /// cannot tell two consecutive identical errors apart from one request repeated forever. A caller
    /// signals with whatever it already has -- NameDialog uses a counter it owns, another caller could use
    /// the error string itself -- and comparison is Equals, so a boxed int works and so does a string.
    ///
    /// Recorded before the await, not after: if FocusAsync throws, the signal must already read as
    /// "handled" so a subsequent render (say, an unrelated keystroke bubbling up to a parent) does not
    /// retry the same failed move forever. Recording it after the await would leave a signal that never
    /// clears whenever the very call that clears it is what fails.
    ///
    /// This stays the only FocusAsync call a dialog makes. The alternative -- letting NameDialog focus its
    /// own field from its own OnAfterRenderAsync -- is exactly what SearchDialog used to do, and the two
    /// calls raced with this component's winning silently. Adding a second trigger for the existing call
    /// (this parameter) rather than a second call site keeps that invariant intact.</summary>
    [Parameter] public object? FocusSignal { get; set; }

    private ElementReference _closeButton;
    private object? _lastFocusSignal;

    protected override void OnInitialized() => Shortcuts.EscapePressed += OnGlobalEscape;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var signalChanged = !Equals(FocusSignal, _lastFocusSignal);
        if (!firstRender && !signalChanged) return;

        // Recorded before the await, not after: a failed focus must not leave the dialog trying again on
        // every subsequent render.
        _lastFocusSignal = FocusSignal;

        try
        {
            await (InitialFocus?.Invoke() ?? _closeButton).FocusAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            // Same three failures FocusAsync can throw everywhere else in this codebase (see
            // Sidebar.FocusDrawerIfJustOpenedAsync) and the same level split: a JSException means
            // Blazor's own focus interop is missing, a real bug worth Warning; a gone circuit or an
            // interop timeout is routine and stays at Debug. Losing the move costs only the
            // keyboard-first workflow and local Escape bubbling -- the scrim, the close button and the
            // document-level Escape shortcut still dismiss the dialog -- so there is nothing to recover
            // and nothing worth surfacing to the user.
            Logger.Log(ex is JSException ? LogLevel.Warning : LogLevel.Debug, ex,
                "Focusing the dialog failed; typing will require a manual click into it.");
        }
    }

    private Task Close() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;

    private void OnGlobalEscape() => InvokeAsync(Close);

    public void Dispose() => Shortcuts.EscapePressed -= OnGlobalEscape;
}
