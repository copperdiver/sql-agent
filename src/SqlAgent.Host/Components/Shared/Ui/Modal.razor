<div class="modal-root" @onkeydown="OnKeyDown" tabindex="-1">
    <div class="modal-scrim" @onclick="Close"></div>
    @* stopPropagation stops the panel's own click from bubbling to the scrim below it and dismissing
       the dialog mid-interaction. It is paired with a no-op handler (rather than left bare) because
       Blazor's own event dispatch only needs the stopPropagation marker to halt the walk up the tree,
       but nothing on this element would otherwise register as "handled" at all — this pairing keeps
       that walk resolvable to something even when the click lands on plain, handler-less content. *@
    <div class="modal-panel" role="dialog" aria-modal="true" aria-label="@Title"
         @onclick="AbsorbPanelClick" @onclick:stopPropagation="true">
        <div class="modal-head">
            <h3>@Title</h3>
            <button type="button" class="ghost modal-close" @onclick="Close" aria-label="Close">
                <Icon Name="x" Size="18" />
            </button>
        </div>
        <div class="modal-body">@ChildContent</div>
        @if (Footer is not null)
        {
            <div class="modal-foot">@Footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();

    private void AbsorbPanelClick() { }

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
}
