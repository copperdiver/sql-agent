@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="message assistant-message">
    <div class="assistant-head">
        <span class="agent-label">SQL Agent</span>
        <div class="message-actions">
            <button type="button" class="ghost" data-testid="assistant-copy" @onclick="CopyAsync">Copy</button>
            @if (OnRegenerate.HasDelegate && Message.OutcomeKind != ChatOutcomeKind.SchemaDiagram)
            {
                <button type="button" class="ghost" data-testid="assistant-regenerate"
                        @onclick="() => OnRegenerate.InvokeAsync(Message)">Regenerate</button>
            }
        </div>
    </div>
    @if (Message.OutcomeKind == ChatOutcomeKind.SchemaDiagram)
    {
        @if (Diagram is { } schema)
        {
            <ErDiagram Schema="schema" ConnectionName="DiagramConnectionName" OnRefresh="OnRefreshDiagram" />
        }
        else
        {
            <OutcomeMessage Code="schema_unavailable" Message="The schema is no longer available for this diagram." />
        }
    }
    else if (Outcome is { GeneratedSql: not null } result)
    {
        <SqlBlock Result="result" ProviderType="ProviderType" Restored="Live is null"
                  OnEdit="OnEdit"
                  OnOpenInEditor="OnOpenInEditor"
                  OnRun="(result.Kind == NlResponseKind.ConfirmationRequired
                      ? EventCallback.Factory.Create(this, () => OnConfirm.InvokeAsync(Message))
                      : EventCallback.Factory.Create(this, () => Task.CompletedTask))" />
    }
    else
    {
        <ChatOutcome Result="Outcome" Restored="Live is null" OnOpenInEditor="OnOpenInEditor" />
    }
</div>

@code {
    [Parameter, EditorRequired] public ChatMessageView Message { get; set; } = default!;

    /// <summary>The in-memory result for an answer produced in this circuit, rows included. Null for
    /// every message read back from the store, which is what makes ChatOutcome render the restored
    /// shape instead of an empty grid.</summary>
    [Parameter] public NlQueryResult? Live { get; set; }

    [Parameter] public EventCallback<string> OnOpenInEditor { get; set; }
    [Parameter] public EventCallback<string> OnEdit { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnConfirm { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnRegenerate { get; set; }
    [Parameter] public DatabaseSchema? Diagram { get; set; }
    [Parameter] public string? DiagramConnectionName { get; set; }
    [Parameter] public EventCallback OnRefreshDiagram { get; set; }
    [Parameter] public DatabaseProviderType ProviderType { get; set; }

    private NlQueryResult? Outcome => Live ?? Restore(Message);

    private Task CopyAsync() => JS.InvokeVoidAsync(
        "navigator.clipboard.writeText", Message.GeneratedSql ?? Message.Text).AsTask();

    /// <summary>
    /// Rebuilds the outcome shape ChatOutcome renders from what the store keeps. Columns and rows are
    /// deliberately empty — they were never written — and the Restored flag above is what stops that
    /// emptiness being drawn as a result.
    /// </summary>
    private static NlQueryResult? Restore(ChatMessageView m) => m.OutcomeKind switch
    {
        ChatOutcomeKind.QueryResult => new NlQueryResult(
            NlResponseKind.QueryResult, m.GeneratedSql, null, null, null,
            [], [], m.RowCount ?? 0, m.Truncated, m.ElapsedMs ?? 0),
        ChatOutcomeKind.Clarification => NlQueryResult.Clarification(m.Text),
        ChatOutcomeKind.ConfirmationRequired when !string.IsNullOrWhiteSpace(m.GeneratedSql) =>
            NlQueryResult.Confirmation(m.GeneratedSql!, m.ConfirmationOperation ?? "write"),
        ChatOutcomeKind.Error => NlQueryResult.Error(
            m.ErrorCode ?? "", m.Text, m.GeneratedSql, m.ElapsedMs ?? 0),
        _ => null,
    };
}
