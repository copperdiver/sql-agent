@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="message user-message">
    <div class="bubble">@Message.Text</div>
    @* Read-only: these attachments are what the question was actually sent with, not a choice still
       being made. *@
    <AttachmentChips Databases="Message.Databases" ReadOnly="true" />
    <div class="message-actions">
        <button type="button" class="ghost" data-testid="user-copy" @onclick="CopyAsync">Copy</button>
        <button type="button" class="ghost" data-testid="user-edit" @onclick="() => OnEdit.InvokeAsync(Message.Text)">Edit</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChatMessageView Message { get; set; } = default!;
    [Parameter] public EventCallback<string> OnEdit { get; set; }

    private Task CopyAsync() => JS.InvokeVoidAsync("navigator.clipboard.writeText", Message.Text).AsTask();
}
