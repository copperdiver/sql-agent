<div class="transcript">
    @foreach (var message in Messages)
    {
        @if (message.Role == ChatRole.User)
        {
            <UserMessage @key="message.Id" Message="message" OnEdit="OnEditUser" />
        }
        else
        {
            @* Keyed by message id so appending a turn does not re-key the whole list and re-run every
               child's lifecycle — the transcript is the one place in this app that grows without bound. *@
            <AssistantMessage @key="message.Id" Message="message"
                              Live="@(Live.TryGetValue(message.Id, out var live) ? live : null)"
                              OnOpenInEditor="OnOpenInEditor"
                              OnEdit="OnEdit"
                              OnConfirm="OnConfirm"
                              OnRegenerate="OnRegenerate"
                              Diagram="@(Diagrams.TryGetValue(message.Id, out var diagram) ? diagram : null)"
                              DiagramConnectionName="@(DiagramConnectionNames.TryGetValue(message.Id, out var name) ? name : null)"
                              OnRefreshDiagram="() => OnRefreshDiagram.InvokeAsync(message)"
                              ProviderType="@(Providers.TryGetValue(message.Id, out var provider) ? provider : DatabaseProviderType.Postgres)" />
        }
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ChatMessageView> Messages { get; set; } = [];

    /// <summary>Results produced in this circuit, by message id. Empty after a reload.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, NlQueryResult> Live { get; set; } =
        new Dictionary<Guid, NlQueryResult>();

    [Parameter] public EventCallback<string> OnOpenInEditor { get; set; }
    [Parameter] public EventCallback<string> OnEdit { get; set; }
    [Parameter] public EventCallback<string> OnEditUser { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnRegenerate { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnConfirm { get; set; }
    [Parameter] public EventCallback<ChatMessageView> OnRefreshDiagram { get; set; }
    [Parameter] public IReadOnlyDictionary<Guid, DatabaseProviderType> Providers { get; set; } =
        new Dictionary<Guid, DatabaseProviderType>();
    [Parameter] public IReadOnlyDictionary<Guid, DatabaseSchema> Diagrams { get; set; } =
        new Dictionary<Guid, DatabaseSchema>();
    [Parameter] public IReadOnlyDictionary<Guid, string> DiagramConnectionNames { get; set; } =
        new Dictionary<Guid, string>();
}
