@using Microsoft.JSInterop
@using SqlAgent.Core
@inject IJSRuntime JS

<section class="er-diagram" data-testid="er-diagram">
    <header class="er-diagram-head">
        <div>
            <span class="eyebrow">SCHEMA</span>
            <h3>Entity relationship diagram</h3>
            @if (!string.IsNullOrWhiteSpace(ConnectionName))
            {
                <p class="muted">@ConnectionName · @Schema.Tables.Count tables</p>
            }
        </div>
        <div class="er-diagram-actions" role="toolbar" aria-label="Diagram controls">
            <button type="button" class="ghost" data-testid="diagram-zoom-out" @onclick="ZoomOut">−</button>
            <button type="button" class="ghost" data-testid="diagram-zoom-in" @onclick="ZoomIn">+</button>
            <button type="button" class="ghost" data-testid="diagram-fit" @onclick="Fit">Fit</button>
            <button type="button" class="ghost" data-testid="diagram-download" @onclick="Download">Download</button>
            @if (OnRefresh.HasDelegate)
            {
                <button type="button" class="ghost" data-testid="diagram-refresh" @onclick="OnRefresh">Refresh</button>
            }
        </div>
    </header>

    <div class="er-diagram-canvas" @ref="_canvas" aria-live="polite"></div>
    <details class="er-diagram-source">
        <summary>Mermaid source</summary>
        <pre data-testid="diagram-source">@Source</pre>
    </details>
</section>

@code {
    [Parameter, EditorRequired] public DatabaseSchema Schema { get; set; } = default!;
    [Parameter] public string? ConnectionName { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private string _renderedSource = "";
    private string Source => MermaidSource.Build(Schema);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/mermaid-diagram.js");

        if (_module is not null && !string.Equals(_renderedSource, Source, StringComparison.Ordinal))
        {
            _renderedSource = Source;
            await _module.InvokeVoidAsync("render", _canvas, Source);
        }
    }

    private async Task CallAsync(string operation, ElementReference canvas, params object[] args)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync(operation, [canvas, .. args]);
    }

    private Task ZoomOut() => CallAsync("zoom", _canvas, 0.85);
    private Task ZoomIn() => CallAsync("zoom", _canvas, 1.15);
    private Task Fit() => CallAsync("fit", _canvas);
    private Task Download() => CallAsync("download", _canvas, "schema-diagram.svg");

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
