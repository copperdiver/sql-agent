@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (Result is { Success: true } r)
{
    <p class="meta">@r.RowCount rows · @r.ElapsedMs ms</p>
    <DataTable Columns="r.Columns" Rows="r.Rows" TotalRowCount="r.RowCount" Truncated="r.Truncated" ShowRowNumbers="false" />
}
else if (Result is { } failed)
{
    <OutcomeMessage Code="@failed.ErrorCode" Message="@failed.ErrorMessage" />
}

@code {
    [Parameter] public QueryExecutionResult? Result { get; set; }

}
