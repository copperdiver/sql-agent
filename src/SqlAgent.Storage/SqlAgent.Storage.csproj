<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SqlAgent.Core\SqlAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <!-- Override EF Core's transitive SQLitePCLRaw 2.1.11 (GHSA-2m69-gcr7-jv3q) with the patched native lib. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
    <!-- DPAPI for the Windows v1 secret store. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- ILogger for the local-access token authenticator (already in EF Core's graph; pinned for the namespace). -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <!-- Design-time only: `dotnet ef migrations add` needs it, the shipped app does not, so
         PrivateAssets keeps it out of the output and out of every consuming project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" PrivateAssets="all" />
    <!-- Override EF Core.Design's transitive System.Security.Cryptography.Xml 9.0.0 (GHSA-23rf-6693-g89p
         and others, fixed in 10.0.10) with the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
